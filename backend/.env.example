# Copy to .env (git-ignored). The key never goes into the app.
OPENROUTER_API_KEY=
# Both models read every hard strip in parallel; the phone cross-checks them. The spare replaces one that fails.
OPENROUTER_MODELS=google/gemma-4-31b-it,google/gemini-2.5-flash-lite
OPENROUTER_SPARE_MODEL=google/gemma-4-26b-a4b-it
RESOLVE_PER_IP_PER_DAY=80
DAILY_BUDGET_USD=2.0
CACHE_MIN_SCORE=92
ALIAS_MIN_REPORTERS=2
# Optional: mirror events into the dashboard's Supabase table
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Public hosting: protect the dashboard feed (GET /v1/events/export needs "Authorization: Bearer <token>")
EXPORT_TOKEN=
# Rate limiting behind a proxy: trust only the proxy's own header (Fly: fly-client-ip), or the N-th
# X-Forwarded-For entry from the right. Leave both empty when running on the laptop.
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=0
